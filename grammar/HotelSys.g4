grammar HotelSys;
reserva: RESERVA campoCliente campoHabitacion campoFecha campoNoches campoPersonas EOF;
campoCliente: CLIENTE EQ IDENT;
campoHabitacion: HABITACION EQ ROOM_ID;
campoFecha: FECHA EQ DATE;
campoNoches: NOCHES EQ INT;
campoPersonas: PERSONAS EQ INT;
RESERVA: 'RESERVA';
CLIENTE: 'CLIENTE';
HABITACION: 'HABITACION';
FECHA: 'FECHA';
NOCHES: 'NOCHES';
PERSONAS: 'PERSONAS';
EQ: '=';
ROOM_ID: 'H' [0-9] [0-9] [0-9];
DATE: [0-9][0-9][0-9][0-9] '-' [0-9][0-9] '-' [0-9][0-9];
INT: [0-9]+;
IDENT: [A-Z]+;
WS: [ \t\r\n]+ -> skip;
